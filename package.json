{
  "name": "luxerp-specification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:tunnel": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:routes": "vitest --config vitest.config.ts run lib/api-route-contract.test.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/auth/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:auth:migrate": "prisma migrate dev --schema prisma/auth/schema.prisma",
    "prisma:auth:deploy": "prisma migrate deploy --schema prisma/auth/schema.prisma",
    "prisma:auth:push": "prisma db push --schema prisma/auth/schema.prisma",
    "prisma:auth:studio": "prisma studio --schema prisma/auth/schema.prisma",
    "prisma:studio": "prisma studio",
    "orders:sync": "node scripts/sync-orders-to-prisma.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.8.2",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.19",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.56.4",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.10",
    "prettier": "^3.5.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
