generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  confirmed
  in_production
  on_hold
  ready
  shipped
  closed
  cancelled
}

enum SpecificationLineType {
  group
  product
  service
  comment
  empty
  subtotal
  total
  discount
  surcharge
}

enum PaymentType {
  prepayment
  final_payment
  refund
  correction
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  other
}

enum UserRole {
  admin
  manager
  production
  accountant
  viewer
}

model Customer {
  id        String   @id
  name      String
  legalType String   @map("legal_type")
  phone     String?
  email     String?
  inn       String?
  address   String?
  comment   String?
  isActive  Boolean  @default(true) @map("is_active")
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Order {
  id                   String              @id
  specificationNumber  String              @unique @map("specification_number")
  documentDate         DateTime            @map("document_date") @db.Date
  customerId           String              @map("customer_id")
  customer             Customer            @relation(fields: [customerId], references: [id])
  customerLegalType    String              @map("customer_legal_type")
  status               OrderStatus         @default(draft)
  productionStartedAt  DateTime?           @map("production_started_at") @db.Date
  readyAt              DateTime?           @map("ready_at") @db.Date
  shippedAt            DateTime?           @map("shipped_at") @db.Date
  categoryId           String?             @map("category_id")
  category             ProductCategory?    @relation(fields: [categoryId], references: [id])
  materialTypeId       String?             @map("material_type_id")
  materialType         MaterialType?       @relation(fields: [materialTypeId], references: [id])
  thicknessMm          Int?                @map("thickness_mm")
  millingTypeId        String?             @map("milling_type_id")
  millingType          MillingType?        @relation(fields: [millingTypeId], references: [id])
  colorCode            String?             @map("color_code")
  mainNote             String?             @map("main_note")
  jointingNote         String?             @map("jointing_note")
  deliveryRequired     Boolean             @default(false) @map("delivery_required")
  deliveryAddress      String?             @map("delivery_address")
  totalAreaM2          Decimal             @default(0) @map("total_area_m2") @db.Decimal(12, 4)
  subtotalAmount       Decimal             @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  surchargeAmount      Decimal             @default(0) @map("surcharge_amount") @db.Decimal(12, 2)
  prepaymentAmount     Decimal             @default(0) @map("prepayment_amount") @db.Decimal(12, 2)
  balanceAmount        Decimal             @default(0) @map("balance_amount") @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdBy            String?             @map("created_by")
  updatedBy            String?             @map("updated_by")
  lines                SpecificationLine[]
  payments             Payment[]
  statusHistory        OrderStatusHistory[]
  attachments          Attachment[]
  auditLog             AuditLog[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([status])
  @@map("orders")
}

model SpecificationLine {
  id            String                @id
  orderId       String                @map("order_id")
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parentId      String?               @map("parent_id")
  parent        SpecificationLine?    @relation("LineTree", fields: [parentId], references: [id])
  children      SpecificationLine[]   @relation("LineTree")
  lineType      SpecificationLineType @map("line_type")
  sortOrder     Int                   @map("sort_order")
  title         String?
  description   String?
  heightMm      Decimal?              @map("height_mm") @db.Decimal(10, 2)
  widthMm       Decimal?              @map("width_mm") @db.Decimal(10, 2)
  quantity      Decimal?              @db.Decimal(10, 3)
  unit          String?
  pricePerM2    Decimal?              @map("price_per_m2") @db.Decimal(12, 2)
  unitAreaM2    Decimal?              @map("unit_area_m2") @db.Decimal(12, 6)
  totalAreaM2   Decimal?              @map("total_area_m2") @db.Decimal(12, 6)
  unitPrice     Decimal?              @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal?              @map("total_price") @db.Decimal(12, 2)
  isCalculated  Boolean               @default(false) @map("is_calculated")
  isPrinted     Boolean               @default(true) @map("is_printed")
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([orderId, sortOrder])
  @@index([parentId])
  @@map("specification_lines")
}

model Payment {
  id            String         @id
  orderId       String         @map("order_id")
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentType   PaymentType    @map("payment_type")
  amount        Decimal        @db.Decimal(12, 2)
  paymentDate   DateTime       @map("payment_date") @db.Date
  paymentMethod PaymentMethod? @map("payment_method")
  comment       String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

model OrderStatusHistory {
  id        String      @id
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")
  changedBy String?     @map("changed_by")
  comment   String?

  @@index([orderId])
  @@map("order_status_history")
}

model ProductCategory {
  id       String  @id
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]

  @@map("product_categories")
}

model MaterialType {
  id       String  @id
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]

  @@map("material_types")
}

model Thickness {
  id       String  @id
  valueMm  Int     @unique @map("value_mm")
  isActive Boolean @default(true) @map("is_active")

  @@map("thicknesses")
}

model MillingType {
  id       String  @id
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]

  @@map("milling_types")
}

model LegalType {
  id   String @id
  code String @unique
  name String

  @@map("legal_types")
}

model User {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(viewer)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Attachment {
  id          String   @id
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("attachments")
}

model AuditLog {
  id        String   @id
  orderId   String?  @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id])
  actorId   String?  @map("actor_id")
  action    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("audit_log")
}
